# Copy only the variable names you need into your local secret manager or
# process environment. Do not commit real passwords.
OPUS_DB_HOST=localhost
OPUS_DB_PORT=5432
OPUS_DB_NAME=connect_logistics_ops
OPUS_DB_USER=connect_ops_app
OPUS_DB_APP_PASSWORD=replace-with-a-long-random-secret
OPUS_DB_CREDENTIAL_TARGET=ConnectLogisticsOps/PostgreSQL/connect_ops_app
# Only used once, by docker-compose, to bootstrap PostgreSQL roles. Not
# needed for a Windows deployment using an existing database server.
OPUS_PG_ADMIN_PASSWORD=replace-with-a-strong-local-secret

# OPUS source connection. The Extraction screen works on every platform: on
# Windows the login is stored in Windows Credential Manager, and on other
# hosts (containers, Linux) it is stored encrypted in OPUS_CREDENTIAL_FILE.
# OPUS_SOURCE_EMAIL/OPUS_SOURCE_PASSWORD below stay available as a
# non-interactive fallback for unattended deployments; a login saved through
# the Extraction screen takes precedence over them.
OPUS_API_URL=https://appsvc.opus4business.com/api/
OPUS_APP_CREDENTIAL_TARGET=ConnectLogisticsOps/OPUS/app.opus4business.com
# OPUS_SOURCE_EMAIL=
# OPUS_SOURCE_PASSWORD=
# Where the encrypted login is written on non-Windows hosts. Defaults to
# ~/.connect-ops/opus_credentials.json, which docker-compose.yml keeps in a
# named volume so it survives restarts. Set OPUS_APP_STORAGE_SECRET (below)
# to derive the encryption key from a secret instead of a generated key file.
# OPUS_CREDENTIAL_FILE=
OPUS_SYNC_MINUTES=2
OPUS_FULL_SYNC_HOURS=24
OPUS_REQUEST_TIMEOUT=45
OPUS_READ_ATTEMPTS=3
OPUS_RETRY_BACKOFF_SECONDS=2
OPUS_DETAIL_WORKERS=8
# Section details are fetched in parallel within each checklist.
OPUS_SECTION_WORKERS=4
OPUS_SCAN_CHUNK_DAYS=1
OPUS_LIVE_LOOKBACK_DAYS=1
OPUS_LIVE_DETAIL_BATCH_SIZE=10
OPUS_BACKLOG_LOOKBACK_DAYS=7
OPUS_ACTIVE_AUDIT_BATCH_SIZE=25
OPUS_AUDIT_BATCH_SIZE=25
OPUS_ACTIVE_SWEEP_MINUTES=4
OPUS_AUDIT_MINUTES=60
OPUS_EXTRACT_FROM=2026-06-29
# OPUS_EXTRACT_TO defaults to today's date when not set; override only to limit the window.
# OPUS_EXTRACT_TO=2026-07-26
OPUS_AUTO_SYNC=true

# NiceGUI development server. The OPUS app uses its own port and environment.
OPUS_APP_HOST=127.0.0.1
OPUS_APP_PORT=8091
OPUS_APP_SHOW=true

# Required before exposing the app beyond a trusted internal network (public
# hosting, shared links, containers reachable from the internet). Leaving
# this blank keeps today's behaviour: no login screen.
# OPUS_APP_ACCESS_PASSWORD=replace-with-a-shared-access-password
# Signs browser session cookies. Auto-derived from the access password when
# blank; set explicitly for a stable, multi-worker, or long-lived deployment.
# OPUS_APP_STORAGE_SECRET=replace-with-a-long-random-secret

